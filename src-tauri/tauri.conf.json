{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitTracer",
  "version": "0.5.0",
  "identifier": "com.git-tracer.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "扫描目录下所有 Git 仓库的待提交内容",
    "longDescription": "Git Tracer 递归扫描指定目录下的所有 Git 仓库，汇总每个仓库的暂存 / 未暂存 / 未跟踪变更，并提供逐文件 diff 预览，无需逐个进入仓库执行 git status。"
  }
}

